{{define "inventory"}}
<div class="inventory-grid">
  <section class="backpack">
    <h3>Backpack</h3>
    <div class="slot-grid">
      {{range .Backpack}}{{template "slot" .}}{{end}}
    </div>
  </section>
  <section class="hotbar">
    <h3>Hotbar</h3>
    <div class="slot-grid hotbar-row">
      {{range .Hotbar}}{{template "slot" .}}{{end}}
    </div>
  </section>
  <section class="equipment">
    <h3>Equipment</h3>
    <div class="equipment-slots">
      {{range .Equipment}}{{template "slot" .}}{{end}}
    </div>
  </section>
</div>
<dialog id="slot-modal" class="slot-modal"></dialog>
{{end}}

{{define "slot"}}
<div class="slot{{if not .Occupied}} slot-empty{{end}}" id="slot-{{.RowID}}"
     data-session-id="{{.SessionID}}"
     data-slot-path="{{.SlotPath}}"
     data-item-path="{{.ItemPath}}"
     data-qty-path="{{.QtyPath}}"
     data-object-path="{{.ObjectPath}}"
     data-name="{{.Name}}"
     data-icon="{{.IconFile}}"
     data-quantity="{{.Quantity}}"
     data-occupied="{{.Occupied}}">
  {{if .Label}}<span class="slot-label">{{.Label}}</span>{{end}}
  {{if .Occupied}}
    <button type="button" class="slot-click-target" title="Click to edit — {{.Name}}">
      <img class="slot-icon" src="/static/icons/{{if .IconFile}}{{.IconFile}}{{else}}placeholder.png{{end}}" alt="{{.Name}}" onerror="window.__iconMissing(this)">
    </button>
    {{if gt .Quantity 1}}<span class="slot-qty">{{.Quantity}}</span>{{end}}
    <form class="slot-remove-form" hx-post="/session/{{.SessionID}}/slot/remove" hx-target="#slot-{{.RowID}}" hx-swap="outerHTML" hx-confirm="Remove this item from the slot?">
      <input type="hidden" name="slotPath" value="{{.SlotPath}}">
      <button type="submit" class="slot-remove-btn" title="Remove item">×</button>
    </form>
  {{else}}
    <button type="button" class="slot-click-target slot-add-btn" title="Add an item to this slot">+</button>
  {{end}}
  {{if .Error}}<span class="error">{{.Error}}</span>{{end}}
</div>
{{end}}
